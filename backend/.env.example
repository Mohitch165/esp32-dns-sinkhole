DATABASE_URL=postgres://sinkhole:sinkhole-local-password@127.0.0.1:5432/sinkhole?sslmode=disable
DEVICE_API_TOKEN=replace-with-a-random-secret-at-least-32-characters-long
LISTEN_ADDR=127.0.0.1:8443
TLS_CERT_FILE=./certs/server.crt
TLS_KEY_FILE=./certs/server.key
GF_DATABASE_PASSWORD=replace-with-the-local-grafana-reader-password
SINKHOLE_GRAFANA_DASHBOARD_PATH=/absolute/path/to/backend/grafana/dashboards
GF_PATHS_PROVISIONING=/absolute/path/to/backend/grafana/provisioning
