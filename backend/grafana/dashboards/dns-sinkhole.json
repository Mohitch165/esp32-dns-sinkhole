          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(successful_blocks),0) AS value FROM dns_event_metrics WHERE $__timeFilter(time) AND (('${device_id:raw}' = 'all' AND device_id <> 'esp32-dns-sinkhole') OR device_id = '${device_id:raw}')",
          "refId": "A"
