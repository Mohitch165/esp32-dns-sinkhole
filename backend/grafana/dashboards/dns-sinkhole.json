      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "sinkhole-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(100.0*SUM(successful_blocks)/NULLIF(SUM(total_queries),0),0) AS value FROM dns_event_metrics WHERE $__timeFilter(time) AND (('${device_id:raw}' = 'all' AND device_id <> 'esp32-dns-sinkhole') OR device_id = '${device_id:raw}')",
          "refId": "A"
        }
      ],
      "description": "Share of accepted DNS queries that matched the blocklist and received an NXDOMAIN response (successful blocks ÷ all accepted queries). This describes your DNS traffic mix; it is not the percentage of ads blocked or a measure of blocking reliability."
    },
